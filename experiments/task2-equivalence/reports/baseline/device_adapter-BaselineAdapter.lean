import Task2.Imported.BaselineCore
import Task2.Trace
set_option maxRecDepth 65536
set_option maxHeartbeats 0
namespace Task2.Imported.BaselineAdapter
open Task2
structure State where
  raw : Task2.Imported.BaselineCore.State
  cycles : Nat
  start : Bool
  observed : Option Word

def inputs (s : State) : Task2.Imported.BaselineCore.Inputs := { i0 := (if s.cycles < 4 then 1 else 0), i1 := (0), i2 := (if s.start then 1 else 0), i3 := (1), i4 := (1), i5 := (1) }

def step (s : State) : State :=
  let r := Task2.Imported.BaselineCore.evaluate (inputs s) s.raw
  { raw := r.nextState, cycles := s.cycles + 1,
    start := if s.cycles < 4 then true else if r.outputs.o1 != 0 then false else s.start,
    observed := if s.cycles < 4 then none else if r.outputs.o4 == 1 then some r.outputs.o3 else none }

def initial (a b : Words) (s : State) : Prop :=
  s.cycles = 0 ∧ s.observed = none ∧
  Task2.Imported.BaselineCore.initialValid s.raw = true ∧
  s.raw.g0.s30 = (fun address => a ⟨address.toNat, address.isLt⟩) ∧
  s.raw.g0.s31 = (fun address => b ⟨address.toNat, address.isLt⟩)

