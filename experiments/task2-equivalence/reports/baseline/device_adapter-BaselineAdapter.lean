theorem initial_exists (a b : Words) : ∃ s, initial a b s := by
  exact ⟨witness a b, rfl, rfl, rfl, rfl, rfl⟩

def advance (s : State) : Nat → State
  | 0 => s
  | n + 1 => step (advance s n)

theorem memoryA_step (s : State) : (step s).raw.g0.s30 = s.raw.g0.s30 := by rfl

theorem memoryA_preserved (s : State) (n : Nat) :
    (advance s n).raw.g0.s30 = s.raw.g0.s30 := by
  induction n with
  | zero => rfl
  | succ n ih => exact Eq.trans (memoryA_step (advance s n)) ih

theorem memoryB_step (s : State) : (step s).raw.g0.s31 = s.raw.g0.s31 := by rfl

theorem memoryB_preserved (s : State) (n : Nat) :
    (advance s n).raw.g0.s31 = s.raw.g0.s31 := by
  induction n with
  | zero => rfl
  | succ n ih => exact Eq.trans (memoryB_step (advance s n)) ih

def harness : Task2.Trace.Harness where
  State := State
  seed := witness
  step := step
  memoryA := fun s => s.raw.g0.s30
  memoryB := fun s => s.raw.g0.s31
  sample := fun s =>
    let r := Task2.Imported.BaselineCore.evaluate (inputs s) s.raw
    { cycle := s.cycles, reset := decide (s.cycles < 4), start := s.start,
      startReady := r.outputs.o1 == 1, tokenValid := r.outputs.o2 == 1,
      doneReady := r.outputs.o0 == 1, payloadReady := true,
      payloadValid := r.outputs.o4 == 1, data := r.outputs.o3 }

end Task2.Imported.BaselineAdapter
namespace Task2.Imported
def baseline : Task2.Device where
  State := Task2.Imported.BaselineAdapter.State
  initial := Task2.Imported.BaselineAdapter.initial
  step := Task2.Imported.BaselineAdapter.step
  result := (·.observed)
end Task2.Imported
